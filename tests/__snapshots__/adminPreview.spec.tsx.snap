exports[`Admin promotions preview snapshot (DOM render) > renders preview panel snapshot after clicking Prévisualiser 1`] = `
"<div class="relative min-h-screen"><div aria-hidden="true" class="absolute inset-0 -z-10"><div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 animate-pulse"></div><div class="absolute inset-0 bg-black/65 backdrop-blur-sm"></div></div><div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 text-white"><div class="mb-6 flex items-center justify-between gap-3 flex-wrap"><h1 class="text-2xl font-bold">Tableau de bord Administrateur</h1><div class="flex gap-2"><button class="px-3 py-2 border rounded">Télécharger JSON</button><button class="px-3 py-2 border rounded">Paiements CSV</button></div></div><div class="mb-6 flex flex-wrap gap-2"><button class="px-4 py-2 rounded border transition-colors duration-150 bg-sky-200 text-blue-900 border-sky-300 hover:bg-sky-300" aria-pressed="false">Produits</button><button class="px-4 py-2 rounded border transition-colors duration-150 bg-sky-200 text-blue-900 border-sky-300 hover:bg-sky-300" aria-pressed="false">Commandes</button><button class="px-4 py-2 rounded border transition-colors duration-150 bg-sky-200 text-blue-900 border-sky-300 hover:bg-sky-300" aria-pressed="false">Clients</button><button class="px-4 py-2 rounded border transition-colors duration-150 bg-sky-200 text-blue-900 border-sky-300 hover:bg-sky-300" aria-pressed="false">Paiements</button><button class="px-4 py-2 rounded border transition-colors duration-150 bg-blue-900 text-white border-blue-900" aria-pressed="true">Promotions</button></div><div class="mt-8 bg-white/95 text-charcoal p-6 rounded shadow max-w-md"><h2 class="font-semibold mb-4">Changer votre mot de passe</h2><form class="space-y-3"><div><label class="block text-sm mb-1" for="currentPassword">Mot de passe actuel</label><input id="currentPassword" class="w-full border rounded px-3 py-2" type="password" value=""></div><div><label class="block text-sm mb-1" for="newPassword">Nouveau mot de passe</label><input id="newPassword" class="w-full border rounded px-3 py-2" type="password" value=""></div><button class="px-4 py-2 bg-black text-white rounded">Mettre à jour</button></form></div><div class="bg-white/95 text-charcoal p-6 rounded shadow"><h2 class="font-semibold mb-4">Promotions &amp; Bons</h2><form class="space-y-6"><div class="flex items-center gap-2"><input id="promotionsActive" type="checkbox" checked="" name="promotionsActive"><label for="promotionsActive">Activer le bandeau de promotion (animation)</label></div><div class="flex items-center gap-2"><input id="vouchersActive" type="checkbox" checked="" name="vouchersActive"><label for="vouchersActive">Activer l'affichage des bons/points sur le site</label></div><div class="flex items-center gap-2"><input id="glowEnabled" type="checkbox" checked="" name="glowEnabled"><label for="glowEnabled">Effet lumineux sur le bandeau</label></div><div><label class="block text-sm mb-1" for="bannerText">Texte du bandeau</label><input id="bannerText" class="w-full border rounded px-3 py-2" value="Promo test" name="bannerText"></div><div><label class="block text-sm mb-1" for="voucherText">Texte des bons</label><input id="voucherText" class="w-full border rounded px-3 py-2" value="Voucher test" name="voucherText"></div><div><label class="block text-sm mb-1" for="marqueeSpeedSeconds">Vitesse défilement (secondes)</label><input id="marqueeSpeedSeconds" min="4" max="120" class="w-full border rounded px-3 py-2" type="number" value="12" name="marqueeSpeedSeconds"></div><fieldset class="border rounded p-4"><legend class="text-sm font-medium px-2">Fond page Login</legend><div class="grid gap-3 md:grid-cols-3"><div><label class="block text-xs mb-1" for="loginDesktop">Desktop</label><input id="loginDesktop" class="w-full border rounded px-2 py-1 text-xs" value="login-good.jpg" name="loginDesktop"><input accept="image/*" class="mt-1 w-full border rounded px-2 py-1 text-[11px]" type="file"></div><div><label class="block text-xs mb-1" for="loginMobile">Mobile</label><input id="loginMobile" class="w-full border rounded px-2 py-1 text-xs" value="" name="loginMobile"><input accept="image/*" class="mt-1 w-full border rounded px-2 py-1 text-[11px]" type="file"></div><div class="md:col-span-3"><label class="block text-xs mb-1" for="loginFallback">Fallback (CSV)</label><input id="loginFallback" class="w-full border rounded px-2 py-1 text-xs" value="" name="loginFallback"></div><div class="md:col-span-3"><label class="block text-xs mb-1" for="loginAlt">Texte alternatif (accessibilité)</label><input id="loginAlt" class="w-full border rounded px-2 py-1 text-xs" value="Login Alt" name="loginAlt"></div></div></fieldset><fieldset class="border rounded p-4 space-y-3"><legend class="text-sm font-medium px-2">Fonds des pages</legend><p class="text-[11px] text-gray-500 mb-1">Vous pouvez soit coller une URL d'image, soit sélectionner un fichier depuis votre ordinateur.</p><div class="grid gap-2 md:grid-cols-6 items-end"><span class="text-xs font-semibold md:col-span-1 capitalize">home</span><input placeholder="Desktop URL" class="border rounded px-2 py-1 text-xs" value="home-good.jpg" name="bgHomeDesktop"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Mobile URL" class="border rounded px-2 py-1 text-xs" value="" name="bgHomeMobile"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Fallback CSV" class="border rounded px-2 py-1 text-xs md:col-span-1" value="" name="bgHomeFallback"><input placeholder="Alt" class="border rounded px-2 py-1 text-xs md:col-span-1" value="Home Alt" name="bgHomeAlt"></div><div class="grid gap-2 md:grid-cols-6 items-end"><span class="text-xs font-semibold md:col-span-1 capitalize">showroom</span><input placeholder="Desktop URL" class="border rounded px-2 py-1 text-xs" value="showroom.jpg" name="bgShowroomDesktop"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Mobile URL" class="border rounded px-2 py-1 text-xs" value="" name="bgShowroomMobile"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Fallback CSV" class="border rounded px-2 py-1 text-xs md:col-span-1" value="" name="bgShowroomFallback"><input placeholder="Alt" class="border rounded px-2 py-1 text-xs md:col-span-1" value="Showroom Alt" name="bgShowroomAlt"></div><div class="grid gap-2 md:grid-cols-6 items-end"><span class="text-xs font-semibold md:col-span-1 capitalize">galeries</span><input placeholder="Desktop URL" class="border rounded px-2 py-1 text-xs" value="galeries.jpg" name="bgGaleriesDesktop"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Mobile URL" class="border rounded px-2 py-1 text-xs" value="" name="bgGaleriesMobile"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Fallback CSV" class="border rounded px-2 py-1 text-xs md:col-span-1" value="" name="bgGaleriesFallback"><input placeholder="Alt" class="border rounded px-2 py-1 text-xs md:col-span-1" value="Galeries Alt" name="bgGaleriesAlt"></div><div class="grid gap-2 md:grid-cols-6 items-end"><span class="text-xs font-semibold md:col-span-1 capitalize">story</span><input placeholder="Desktop URL" class="border rounded px-2 py-1 text-xs" value="story.jpg" name="bgStoryDesktop"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Mobile URL" class="border rounded px-2 py-1 text-xs" value="" name="bgStoryMobile"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Fallback CSV" class="border rounded px-2 py-1 text-xs md:col-span-1" value="" name="bgStoryFallback"><input placeholder="Alt" class="border rounded px-2 py-1 text-xs md:col-span-1" value="Story Alt" name="bgStoryAlt"></div><div class="grid gap-2 md:grid-cols-6 items-end"><span class="text-xs font-semibold md:col-span-1 capitalize">admin</span><input placeholder="Desktop URL" class="border rounded px-2 py-1 text-xs" value="admin.jpg" name="bgAdminDesktop"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Mobile URL" class="border rounded px-2 py-1 text-xs" value="" name="bgAdminMobile"><input accept="image/*" class="border rounded px-2 py-1 text-[11px] md:col-span-1" type="file"><input placeholder="Fallback CSV" class="border rounded px-2 py-1 text-xs md:col-span-1" value="" name="bgAdminFallback"><input placeholder="Alt" class="border rounded px-2 py-1 text-xs md:col-span-1" value="Admin Alt" name="bgAdminAlt"></div></fieldset><fieldset class="border rounded p-4 space-y-2"><legend class="text-sm font-medium px-2">Stickers (JSON array)</legend><textarea name="stickers" class="w-full border rounded px-2 py-1 text-xs h-32">[
