# Copy to terraform.tfvars and fill with real values before terraform apply
project_id = "your-gcp-project-id"
region     = "europe-west1"
domain     = "example.com"
api_subdomain = "api.example.com"
bucket_name = "example-static-bucket-unique"
artifact_repo_id = "luxe-repo"
cloud_run_image = "europe-west1-docker.pkg.dev/your-gcp-project-id/your-repo/luxe-api:latest"
cloud_run_service_name = "luxe-modern-ecommerce-api"
cloud_run_cpu = "1"
cloud_run_memory = "512Mi"
cloud_run_concurrency = 80
cloud_run_min_instances = 0
cloud_run_max_instances = 5
jwt_secret = "replace_with_strong_jwt_secret"
admin_email = "admin@example.com"
admin_password = "ChangeMe_Initial_Admin_Password!"
allowed_origins = "https://www.example.com,https://example.com"
cookie_domain = ".example.com"
stripe_secret_key = "sk_test_..."
stripe_webhook_secret = "whsec_..."
stripe_currency = "usd"
enable_cloud_sql = false
enable_cloud_build_trigger = true
deploy_static_from_ci = false
ci_run_tests = true
ci_run_migrations = false
github_owner = "Marubozu-Ousseini"
github_repo = "Luxe-Modern-E-commerce"
github_branch = "main"
log_retention_days = 30
enable_reset_admin_job = true
billing_account_id = ""
budget_amount = 100
budget_notification_thresholds = [0.5, 0.8, 1.0]
uptime_check_enabled = true
uptime_check_period_minutes = 5
# Optional overrides
# db_name = "luxe_db"
# db_user = "luxe_user"
