{
  "name": "luxe-ecommerce-fullstack",
  "version": "1.0.0",
  "description": "Application e-commerce full-stack avec React et Node.js, optimisée pour GCP.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src-server/server.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "preview": "vite preview --port 3000",
    "reset-admin": "tsx scripts/reset-admin.ts",
    "make:admin": "tsx scripts/make-admin.ts",
    "migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "deploy:firebase": "firebase deploy --only hosting,functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "drizzle:generate": "drizzle-kit generate:pg --schema=src-server/db/schema.ts --out=drizzle/migrations",
    "drizzle:migrate": "drizzle-kit migrate:pg --schema=src-server/db/schema.ts --out=drizzle/migrations"
  },
  "keywords": [
    "react",
    "nodejs",
    "express",
    "ecommerce",
    "gcp"
  ],
  "author": "AI Studio",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.5.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase": "^10.12.0",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^7.0.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "latest": "^0.2.0",
    "multer": "^2.0.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0",
    "stripe": "^19.3.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.24.0",
    "firebase-tools": "^13.0.1",
    "jsdom": "^27.2.0",
    "minimist": "^1.2.8",
    "postcss": "^8.5.6",
    "puppeteer": "^24.34.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.15.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.8",
    "vitest": "^4.0.9"
  }
}
